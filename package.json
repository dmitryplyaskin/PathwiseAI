{
  "name": "pathwiseai",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "install:all": "yarn install:server && yarn install:web",
    "install:server": "yarn --cwd server install",
    "install:web": "yarn --cwd web install",
    "build": "yarn build:all",
    "build:server": "yarn --cwd server build",
    "build:web": "yarn --cwd web build",
    "build:all": "yarn build:web && yarn build:server",
    "clean:server": "pwsh -NoProfile -Command \"Remove-Item -LiteralPath 'server/dist','server/node_modules' -Recurse -Force -ErrorAction SilentlyContinue\"",
    "clean:web": "pwsh -NoProfile -Command \"Remove-Item -LiteralPath 'web/dist','web/node_modules' -Recurse -Force -ErrorAction SilentlyContinue\"",
    "clean:all": "yarn clean:server && yarn clean:web",
    "clean": "yarn clean:all",
    "start": "yarn start:dev",
    "start:dev": "yarn --cwd server start:dev",
    "start:debug": "yarn --cwd server start:debug",
    "start:prod": "node server/dist/main.js",
    "start:web": "yarn --cwd web dev",
    "preview:web": "yarn --cwd web preview",
    "lint": "yarn lint:server && yarn lint:web",
    "lint:server": "yarn --cwd server lint",
    "lint:web": "yarn --cwd web lint",
    "test": "yarn --cwd server test",
    "test:watch": "yarn --cwd server test:watch",
    "test:cov": "yarn --cwd server test:cov",
    "test:e2e": "yarn --cwd server test:e2e",
    "seed": "yarn --cwd server seed",
    "migrate:exams-lesson-link": "yarn --cwd server migrate:exams-lesson-link"
  }
}